            "使用者訊息": "={{ $('統一回覆與紀錄').first().json.userText }}",
            "回覆": "={{ $('統一回覆與紀錄').first().json.replyText }}",
            "是否待人工": "={{ $('統一回覆與紀錄').first().json.waitingForHuman ? '是' : '否' }}"
          },
          "matchingColumns": [],
