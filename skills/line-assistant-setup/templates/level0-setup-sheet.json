          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "condition-record-created",
              "leftValue": "={{ $json.recordCreated }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000012",
      "name": "準備紀錄表頭",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2420, -120],
      "parameters": {"mode": "runOnceForAllItems", "jsCode": "return [{ json: { '時間': '', '使用者訊息': '', '回覆': '', '是否待人工': '' } }];"}
    },
    {
      "id": "00000000-0000-4000-8000-000000000013",
      "name": "初始化紀錄分頁",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [2640, -120],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {"__rl": true, "value": "={{ $('取出試算表 ID').first().json.spreadsheetId }}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "紀錄", "mode": "name"},
        "columns": {"mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": []},
        "options": {}
      },
      "credentials": {"googleApi": {}},
      "notes": "只有本次新建「紀錄」時才執行；空字串不會形成有內容的資料列，只留下四欄表頭。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "顯示建表結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const qaCreated = Boolean($('標記問答建立結果').first().json.qaCreated);\nconst recordCreated = Boolean($('標記紀錄建立結果').first().json.recordCreated);\nconst createdSheets = [];\nif (qaCreated) createdSheets.push('問答');\nif (recordCreated) createdSheets.push('紀錄');\nconst result = createdSheets.length ? `已建立：${createdSheets.join('、')}` : '兩個分頁都已存在，未變更';\nreturn [{ json: { result, createdSheets } }];"
      },
      "notes": "預設的「工作表1」不刪除：刪除不是建表必要動作，且保留可避免誤刪學員已有資料。"
    }
  ],
