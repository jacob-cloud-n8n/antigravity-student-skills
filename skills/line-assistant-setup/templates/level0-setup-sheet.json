{
  "name": "課程範本 0｜建立 LINE 助理試算表",
  "nodes": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "手動執行一次",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {},
      "notes": "設定好試算表網址與 Google 服務帳戶憑證後，按一次「執行 workflow」。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "貼上試算表網址",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "spreadsheet-url-input",
              "name": "spreadsheetUrl",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "notes": "請把空白 Google 試算表的完整網址（或試算表 ID）貼到 spreadsheetUrl。記得先把試算表共用給服務帳戶，權限設為編輯者。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "取出試算表 ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = String($input.first()?.json?.spreadsheetUrl || '').trim();\nconst urlMatch = raw.match(/\\/spreadsheets\\/d\\/([a-zA-Z0-9_-]+)/);\nconst spreadsheetId = urlMatch?.[1] || (/^[a-zA-Z0-9_-]{20,}$/.test(raw) ? raw : '');\n\nif (!spreadsheetId) {\n  throw new Error('請在「貼上試算表網址」節點填入正確的 Google 試算表網址或 ID。');\n}\n\nreturn [{ json: { spreadsheetId } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "確保有問答分頁",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [660, 0],
      "alwaysOutputData": true,
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "create",
        "documentId": {"__rl": true, "value": "={{ $('取出試算表 ID').first().json.spreadsheetId }}", "mode": "id"},
        "title": "問答",
        "options": {}
      },
      "credentials": {"googleApi": {}},
      "notes": "內建 Google Sheets「建立分頁」操作會先檢查同名分頁；已存在時直接跳過，不重建。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "標記問答建立結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const created = String($input.first()?.json?.title || '') === '問答';\nreturn [{ json: { spreadsheetId: $('取出試算表 ID').first().json.spreadsheetId, qaCreated: created } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "問答是新建的嗎",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [
            {
              "id": "condition-qa-created",
              "leftValue": "={{ $json.qaCreated }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000007",
      "name": "準備問答表頭與範例",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -120],
      "parameters": {"mode": "runOnceForAllItems", "jsCode": "return [{ json: { '關鍵字': '營業時間', '回覆': '每天 10:00–18:00' } }];"}
    },
    {
      "id": "00000000-0000-4000-8000-000000000008",
      "name": "初始化問答分頁",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1540, -120],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": {"__rl": true, "value": "={{ $('取出試算表 ID').first().json.spreadsheetId }}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "問答", "mode": "name"},
        "columns": {"mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": []},
        "options": {}
      },
      "credentials": {"googleApi": {}},
      "notes": "只有本次新建「問答」時才執行；內建 Append 在空白分頁會以輸入欄位建立表頭，並加入一列範例。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000009",
      "name": "確保有紀錄分頁",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1760, 0],
      "alwaysOutputData": true,
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "sheet",
        "operation": "create",
        "documentId": {"__rl": true, "value": "={{ $('取出試算表 ID').first().json.spreadsheetId }}", "mode": "id"},
        "title": "紀錄",
        "options": {}
      },
      "credentials": {"googleApi": {}},
      "notes": "內建 Google Sheets「建立分頁」操作會先檢查同名分頁；已存在時直接跳過，不重建。"
    },
    {
      "id": "00000000-0000-4000-8000-000000000010",
      "name": "標記紀錄建立結果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const created = String($input.first()?.json?.title || '') === '紀錄';\nreturn [{ json: { spreadsheetId: $('取出試算表 ID').first().json.spreadsheetId, recordCreated: created } }];"
      }
    },
    {
      "id": "00000000-0000-4000-8000-000000000011",
      "name": "紀錄是新建的嗎",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
